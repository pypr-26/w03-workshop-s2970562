{
    "python.terminal.executeInFileDir": true,
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    "python.REPL.sendToNativeREPL": true,

    "git.rebaseWhenSync": true,
    "git.openAfterClone": "always",

    "chat.disableAIFeatures": false,

    "editor.lineHeight": 17,
    "breadcrumbs.enabled": false,
    "notebook.insertToolbarLocation": "notebookToolbar",
    "notebook.showCellStatusBar": "hidden",
    "notebook.cellToolbarLocation": {
        "jupyter-notebook": "hidden"
    },
    "notebook.globalToolbar": false,
    "notebook.consolidatedRunButton": true,
    "notebook.lineNumbers": "on",

    "python.analysis.supportDocstringTemplate": false,
    "editor.inlineSuggest.enabled": false,
    "editor.parameterHints.enabled": false,
    "editor.snippetSuggestions": "none",
    "workbench.settings.showAISearchToggle": false,
    "notebook.experimental.generate": false,
    "python.experiments.enabled": false,

    "workbench.startupEditor": "welcomePage",

    "files.exclude": {
      "**/__pycache__": true,
      "**/.ipynb_checkpoints": true,
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/*.crswap": true
    }
}
